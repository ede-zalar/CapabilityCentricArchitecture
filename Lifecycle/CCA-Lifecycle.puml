@startuml cca-lifecycle-management-startup
participant Host
participant configuration
participant CapabilityFactory
participant CapabilityRegistry
participant LifecycleManager
participant OtherCapabilityDescriptor
participant OtherCapabilityInstance

[-> Host++ : start
Host -> CapabilityFactory** : new
Host -> CapabilityRegistry** : new(configuration)
Host -> LifecycleManager** : new
Host -> LifecycleManager++ : initialize(registry, factory)
	LifecycleManager -> CapabilityRegistry++ : register capabilities
		loop read all configured capabilities
			CapabilityRegistry -> configuration : read capability info
			CapabilityRegistry -> CapabilityFactory++ : create CapabilityDescriptor from info
			create OtherCapabilityDescriptor
			CapabilityFactory -> OtherCapabilityDescriptor : new
			return
			CapabilityRegistry -> CapabilityRegistry : store in Map
		end loop
	return
	LifecycleManager -> CapabilityRegistry++ : getInitializationOrder()
	return
	loop for each registered capability
		LifecycleManager -> OtherCapabilityDescriptor++ : createInstance()
		OtherCapabilityDescriptor -> OtherCapabilityInstance** : new
		return otherCapabilityInstance
		LifecycleManager -> OtherCapabilityInstance++ : injectDependencies()
		return
		LifecycleManager -> OtherCapabilityInstance++ : initialize()
		return
		LifecycleManager -> LifecycleManager : add to initialized capabilities
	end loop
	LifecycleManager -> LifecycleManager : report any missing capability
return 
Host -> LifecycleManager++ : startup()
	alt If NOT all mandatory capabilities are initialized
		LifecycleManager -> LifecycleManager : stop execution
	else
		loop for each initialized capability
			LifecycleManager -> OtherCapabilityInstance++ : start()
			return
			LifecycleManager -> LifecycleManager : add to started capabilities
		end loop
	end
return

@enduml

@startuml cca-lifecycle-management

rectangle "Capability Lifecycle Management" {
	rectangle "Adaptation" {
		class LifecycleMgmtCapability {
			-CapabilityRegistry registry
			-CapabilityFactory factory
			+void initialize(configuration)
			+void startup()
			+void shutdown()
		}
		rectangle "Realization" {
			class CapabilityRegistry {
				-Map<String, CapabilityDescriptor> descriptors
				-Map<String, CapabilityInstance> instances
				-Map<Class<?>, String> provisionToCapabilityMap
				-DirectedGraph<String> dependencyGraph
				+public CapabilityRegistry()
				+void registerCapability(CapabilityDescriptor descriptor)
				+void registerInstance(String capabilityId, CapabilityInstance instance)
				+void buildDependencyGraph()
				+List<String> getInitializationOrder()
				+CapabilityInstance getInstance(String capabilityId)
				+CapabilityDescriptor getDescriptor(String capabilityId)
				+String findProvider(Class<?> contractType)
				+Set<String> getAllCapabilityIds()
			}
			class CapabilityFactory {
				-Map<String, Object> constructorParameters
				+CapabilityFactory()
				+void registerParameters(String capabilityType, Object... params)
				+CapabilityInstance createInstance(CapabilityDescriptor descriptor)
				-CapabilityInstance createWithParameters(Class<? extends CapabilityInstance> clazz, Object[] params)
			}
			rectangle "Essence" {
				class CapabilityLifecycleManager {
					-CapabilityRegistry registry
					-CapabilityFactory factory
					-Map<String, LifecycleState> stateMap
					+CapabilityLifecycleManager(CapabilityRegistry, CapabilityFactory)
					+void initializeAll()
					-void initializeCapability(capabilityId)
					+void injectDependencies()
					-void injectDependenciesForCapability(capabilityId)
					+void startAll()
					-void startCapability(capabilityId)
					+void stopAll()
					-void stopCapability(capabilityId)
					+void cleanupAll()
					-void cleanupCapability(capabilityId)
					+LifecycleState getState(capabilityId)
					+void startSystem()
					+void shutdownSystem()
				}
				enum LifecycleState {
					NOT_CREATED
					CREATED
					INITIALIZED
					DEPENDENCIES_INJECTED
					STARTED
					STOPPED
					CLEANED_UP
				}
				LifecycleState <.. CapabilityLifecycleManager
			} /' Essence '/
		} /' Realization '/
		CapabilityLifecycleManager .right.> CapabilityFactory
	} /' Adaptation '/

	rectangle "Contracts" {
		interface CapabilityInstance {
			void initialize()
			void start()
			void stop()
			void cleanup()
			Object getContractImplementation(Class<?> contractType)
			void injectDependency(Class<?> contractType, Object implementation)
		}
	} /' Contracts '/
	CapabilityLifecycleManager ..> CapabilityInstance
}

@enduml
