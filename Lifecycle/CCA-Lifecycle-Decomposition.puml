@startuml CCA-Lifecycle-Management-Decomposition

rectangle "Capability Lifecycle Management" {
	rectangle "Adaptation" {
		class LifecycleMgmtCapability {
			-CapabilityRegistry registry
			-CapabilityFactory factory
			+void initialize(configuration)
			+void startup()
			+void shutdown()
		}
		rectangle "Realization" {
			class CapabilityRegistry {
				-Map<String, CapabilityDescriptor> descriptors
				-Map<String, CapabilityInstance> instances
				-Map<Class<?>, String> provisionToCapabilityMap
				-DirectedGraph<String> dependencyGraph
				+public CapabilityRegistry()
				+void registerCapability(CapabilityDescriptor descriptor)
				+void registerInstance(String capabilityId, CapabilityInstance instance)
				+void buildDependencyGraph()
				+List<String> getInitializationOrder()
				+CapabilityInstance getInstance(String capabilityId)
				+CapabilityDescriptor getDescriptor(String capabilityId)
				+String findProvider(Class<?> contractType)
				+Set<String> getAllCapabilityIds()
			}
			class CapabilityFactory {
				-Map<String, Object> constructorParameters
				+CapabilityFactory()
				+void registerParameters(String capabilityType, Object... params)
				+CapabilityInstance createInstance(CapabilityDescriptor descriptor)
				-CapabilityInstance createWithParameters(Class<? extends CapabilityInstance> clazz, Object[] params)
			}
			note bottom of CapabilityFactory
				This factory is responsible 
				to create instances of the main objects 
				from other capabilities.
			end note
			rectangle "Essence" {
				class CapabilityLifecycleManager {
					-CapabilityRegistry registry
					-CapabilityFactory factory
					-Map<String, LifecycleState> stateMap
					+CapabilityLifecycleManager(CapabilityRegistry, CapabilityFactory)
					+void initializeAll()
					-void initializeCapability(capabilityId)
					+void injectDependencies()
					-void injectDependenciesForCapability(capabilityId)
					+void startAll()
					-void startCapability(capabilityId)
					+void stopAll()
					-void stopCapability(capabilityId)
					+void cleanupAll()
					-void cleanupCapability(capabilityId)
					+LifecycleState getState(capabilityId)
					+void startSystem()
					+void shutdownSystem()
				}
				enum LifecycleState {
					NOT_CREATED
					CREATED
					INITIALIZED
					DEPENDENCIES_INJECTED
					STARTED
					STOPPED
					CLEANED_UP
				}
				LifecycleState <.. CapabilityLifecycleManager
			} /' Essence '/
		} /' Realization '/
		CapabilityLifecycleManager .right.> CapabilityFactory
	} /' Adaptation '/

	rectangle "Contracts" {
		interface CapabilityInstance {
			void initialize()
			void start()
			void stop()
			void cleanup()
			Object getContractImplementation(Class<?> contractType)
			void injectDependency(Class<?> contractType, Object implementation)
		}
	} /' Contracts '/
	CapabilityLifecycleManager ..> CapabilityInstance
}

@enduml
